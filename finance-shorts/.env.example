# Copy to .env (gitignored; never commit keys). Neither key is needed to render with --script.
ANTHROPIC_API_KEY=
PEXELS_API_KEY=
# Optional voice and sound settings (defaults shown). Audition voices with: python -m src.voices
# SHORTS_VOICE=en-US-RogerNeural
# SHORTS_RATE=+22%
# SHORTS_PITCH=-6Hz
# SHORTS_MUSIC_VOL=0.06     # music level under the voice (also ducks while he talks); 0.035 quieter, 0.12 louder
# SHORTS_MUSIC=mobster      # mobster (smoky jazz, default) | klezmer (silly) | off, or --no-music when you add a licensed track in YouTube
# SHORTS_MODEL=claude-sonnet-5-5
