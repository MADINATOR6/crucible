# Copy to .env (gitignored; never commit keys). Neither key is needed to render with --script.
ANTHROPIC_API_KEY=
PEXELS_API_KEY=
# Local Paulie is the default; requires the approved reference and CUDA runtime under %USERPROFILE%/.local/share/PaulieVoice plus the cached Qwen model.
# SHORTS_VOICE_PROFILE=paulie  # paulie | edge; or pass --voice paulie|edge
# A scene's chuckle:true uses %USERPROFILE%/.local/share/PaulieVoice/paulie-laugh.wav (recorded reference excerpt).
# Edge mode uses the settings below; SHORTS_VOICE alone does not replace the approved Paulie default.
# Audition Edge voices with: python -m src.voices
# SHORTS_VOICE=en-US-RogerNeural
# SHORTS_RATE=+22%
# SHORTS_PITCH=-6Hz
# SHORTS_MUSIC_VOL=0.06     # music level under the voice (also ducks while he talks); 0.035 quieter, 0.12 louder
# SHORTS_MUSIC=mobster      # mobster (smoky jazz, default) | klezmer (silly) | off, or --no-music when you add a licensed track in YouTube
# SHORTS_MODEL=claude-sonnet-5-5
