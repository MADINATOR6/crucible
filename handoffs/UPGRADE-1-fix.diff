+    $baseline = if ($Task.baselines -is [Collections.IDictionary]) {
+        $key = [IO.Path]::GetFullPath($Root).TrimEnd('\','/').ToLowerInvariant()
+        @($Task.baselines[$key] | Where-Object { $_ })
